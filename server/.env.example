# 复制为 .env 并填入真实值（.env 不会被提交到仓库）
# 也可以直接 export 这些环境变量，两者等价

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=photo_app
MYSQL_PASSWORD=
MYSQL_DATABASE=photo_app

# 火山引擎 TOS 对象存储
TOS_ACCESS_KEY_ID=
TOS_ACCESS_KEY_SECRET=
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_BUCKET=

# 豆包 Seedream API
DOUBAO_API_KEY=

# 可选：JWT 签名密钥，不填使用内置默认值
# SECRET_KEY=

# 可选：init_db.py 创建初始管理员时的密码，不填为 admin123
# ADMIN_INIT_PASSWORD=
